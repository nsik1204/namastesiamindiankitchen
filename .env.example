# ====================================================================
# Namaste Siam Indian Kitchen — Environment Variables Template
# ====================================================================

# --- Public Client Variables (Vite / Frontend) ---
# Your Supabase Project URL (Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anonymous Public Key (Safe for client-side queries protected by RLS)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Secret access key for reaching the admin gate at /unlock-admin?k=YOUR_KEY
VITE_ADMIN_UNLOCK_KEY=your-admin-unlock-key-here

# --- Server-Side Only Variables (Optional: for server.ts / Express execution) ---
# NEVER expose the service role key to frontend bundles!
PORT=3000
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
ADMIN_EMAIL=namastesiamindiankitchen@gmail.com

